#!/usr/bin/env bash
# Hook pre-push de Chords: análisis + tests antes de empujar.
# Instalado por `make hooks` (chords_cli hooks install).
set -euo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT"

echo "[pre-push] flutter analyze"
flutter analyze --fatal-infos --fatal-warnings

echo "[pre-push] banco de acordes"
dart run bin/chords_cli.dart db validate

echo "[pre-push] auditoría de arquitectura"
if ! dart run bin/chords_cli.dart audit --root . --fail-on error; then
  echo "[pre-push] la auditoría falla: corrige los hallazgos o ejecuta 'make audit'"
  exit 1
fi

echo "[pre-push] flutter test"
flutter test

echo "[pre-push] OK"
